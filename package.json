{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@redux-devtools/extension": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.11",
    "antd": "^5.23.0",
    "axios": "^1.7.9",
    "cra-template": "1.2.0",
    "dayjs": "^1.11.13",
    "gsap": "^3.12.5",
    "lucide-react": "^0.539.0",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-masonry-css": "^1.0.16",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "react-snap": "^1.23.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.83.1",
    "streamsaver": "^2.0.6",
    "swiper": "^11.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "destination": "build",
    "include": [
      "/",
      "/portfolio",
      "/about",
      "/prices"
    ],
    "exclude": [
      "/login",
      "/admin"
    ],
    "inlineCss": true,
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "waitUntil": "networkidle0",
    "waitAfterLoad": 1000,
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "concurrency": 2
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
